{
  "display_information": {"name": "ReconIQ", "description": "Bank reconciliation intake"},
  "features": {"bot_user": {"display_name": "ReconIQ", "always_online": false}},
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "chat:write", "files:read", "channels:read", "channels:history", "groups:read", "groups:history", "users:read"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR-BACKEND-HOST/slack/events",
      "bot_events": ["app_mention", "message.channels", "message.groups", "file_shared"]
    },
    "socket_mode_enabled": false,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
