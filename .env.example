# PRD section 18. All configuration is environment variables; none lives in code.
# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+asyncpg://bankrecon:bankrecon@db:5432/bankrecon

SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me
SLACK_APP_TOKEN=xapp-replace-me
SLACK_CLIENT_ID=replace-me
SLACK_CLIENT_SECRET=replace-me
SLACK_RECON_CHANNEL_ID=
SLACK_EVIDENCE_CHANNEL_IDS=
WEB_APP_URL=

ANTHROPIC_API_KEY=sk-ant-replace-me
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_REASONING_ENABLED=true
# The PRD pins claude-sonnet-4-6. Sonnet 5 is the current generation of the same
# tier: cheaper ($2/$10 vs $3/$15 per 1M tokens) and stronger. Set it back to
# claude-sonnet-4-6 if you need to pin the exact PRD value.
ANTHROPIC_MODEL=claude-sonnet-5

STORAGE_PATH=/data/statements

AUTO_MATCH_THRESHOLD=90
REVIEW_FLOOR=60
AMBIGUITY_GAP=5
DATE_WINDOW_DAYS=5
AMOUNT_TOLERANCE_BPS=0
APPROVAL_VALUE_THRESHOLD_MINOR=50000000

LISTENER_THRESHOLD=55
LISTENER_PER_CASE_COOLDOWN_HOURS=6
LISTENER_MAX_PER_CASE=3
LISTENER_MAX_PER_WORKSPACE_HOUR=10

EVIDENCE_BACKFILL_DAYS=60
AGENT_MAX_TURNS=6
LLM_CALL_BUDGET_PER_RUN=250
STATEMENT_RETENTION_DAYS=30

DEMO_MODE=false
LOG_LEVEL=INFO

# Shared secret the web app's server sends on every /api/v1 call. /api/v1 refuses
# all requests while it is empty. Use the same value in the frontend deployment.
INTERNAL_API_TOKEN=replace-with-a-long-random-string
